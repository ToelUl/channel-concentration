{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ToelUl/channel-concentration/blob/main/release/RELEASE_CONTENT_MANIFEST.schema.json",
  "title": "Channel Concentration release content manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release_name",
    "repository",
    "content_commit",
    "content_tree",
    "content_commit_date",
    "files",
    "totals",
    "scope"
  ],
  "properties": {
    "schema": {"const": "channel-concentration-release-content-manifest/1.0"},
    "release_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
    "repository": {"type": "string", "format": "uri"},
    "content_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "content_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "content_commit_date": {"type": "string"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "git_blob", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "mode": {"enum": ["100644", "100755"]},
          "git_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "bytes"],
      "properties": {
        "files": {"type": "integer", "minimum": 1},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "scope": {"type": "string", "minLength": 1}
  }
}
